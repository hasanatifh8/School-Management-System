# PostgreSQL connection used by the app (on Neon: the *pooled* connection string).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional: direct (non-pooled) connection used for migrations (on Neon: the direct string).
# Falls back to DATABASE_URL when not set.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Password for the Power Admin area at /power (at least 10 characters).
# Leave unset to keep Power Admin switched off.
POWER_ADMIN_PASSWORD=""

# Admin "Ask AI" assistant: any OpenAI-compatible server running an open-source model.
# Locally, leave these unset to use Ollama (http://localhost:11434/v1) with qwen2.5:7b.
# In production the assistant stays off until AI_BASE_URL and AI_MODEL are set.
# AI_BASE_URL="https://api.groq.com/openai/v1"
# AI_MODEL="openai/gpt-oss-120b"
# AI_API_KEY=""
