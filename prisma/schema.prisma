// School Management System — data model.
// Every record belongs to a School so the app can later serve several schools
// from one database (created by a Super Admin).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE // "removed" — kept for history instead of being deleted
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SessionStatus {
  UPCOMING
  CURRENT
  CLOSED
}

// Outcome of a student's year, set when the class is promoted.
enum EnrollmentResult {
  PROMOTED
  DETAINED
  LEFT
  PASSED_OUT
}

enum StudentCategory {
  GENERAL
  OBC
  SC_ST
  MINORITY
}

// Who a school admin account is: a full admin, or non-teaching staff who
// only see the Fees section.
enum StaffRole {
  ADMIN
  ACCOUNTANT
}

enum FeeFrequency {
  ONE_TIME // once per student, e.g. admission fee (students admitted this session)
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY // once a session, in a chosen month (annual charges, extra dues)
}

enum PaymentMode {
  CASH
  UPI
  CARD
  CHEQUE
  BANK_TRANSFER
  OTHER
}

enum MessageChannel {
  WHATSAPP
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // no phone number
}

enum PayeeType {
  TEACHER
  STAFF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum LeaveApplicant {
  STUDENT
  TEACHER
  STAFF
}

enum LeaveCategory {
  SICK
  CASUAL
  FAMILY
  EMERGENCY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  AADHAAR
  PAN
  BIRTH_CERTIFICATE
  TRANSFER_CERTIFICATE
  MARKSHEET
  CASTE_CERTIFICATE
  MEDICAL_CERTIFICATE
  RESUME
  EDUCATION_CERTIFICATE
  EXPERIENCE_LETTER
  ADDRESS_PROOF
  OTHER
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

enum SchoolType {
  PRIVATE
  GOVERNMENT
  SEMI_GOVERNMENT
  OTHER
}

model School {
  id               String       @id @default(cuid())
  name             String
  code             String       @unique
  status           SchoolStatus @default(ACTIVE)
  board            String?
  schoolType       SchoolType?
  udiseCode        String? // UDISE+ code issued by the Ministry of Education (11 digits)
  affiliationNo    String? // affiliation / registration number with the board
  affiliationYear  Int?
  principalName    String?
  establishedYear  Int?
  motto            String?
  address          String?
  phone            String?
  email            String?
  website          String?
  idCardEmergency  String? // back of every ID card: one contact per line, e.g. "Ambulance: 108"
  idCardGuidelines String? // back of every ID card: one guideline per line
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  timetableDays    Int[]        @default([1, 2, 3, 4, 5, 6]) // school days in the timetable, 1 = Monday … 7 = Sunday

  logo   SchoolLogo?
  admins SchoolAdmin[]

  students  Student[]
  teachers  Teacher[]
  classes   SchoolClass[]
  subjects  Subject[]
  counters  Counter[]
  photos    Photo[]
  documents Document[]
  houses    House[]
  sessions  AcademicSession[]

  attendanceDays  AttendanceDay[]
  holidays        Holiday[]
  staffAttendance StaffAttendance[]
  transportRoutes TransportRoute[]
  leaveRequests   LeaveRequest[]
  feeHeads        FeeHead[]
  feeReceipts     FeeReceipt[]
  staffMembers    StaffMember[]
  salaryPayments  SalaryPayment[]
  expenseCats     ExpenseCategory[]
  expenses        Expense[]
  messaging       MessagingSettings?
  notices         Notice[]
  exams           Exam[]
  periods         Period[]
  calendarEvents  CalendarEvent[]
}

// A school house (e.g. "Green House"). Names and colours are set by the admin.
model House {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  color       String // palette key, see src/lib/houses.ts
  description String?
  createdAt   DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students Student[]

  @@unique([schoolId, name])
}

// Passport photo of a student or teacher. Kept in its own table so that
// loading people never loads image bytes unless they are requested.
model Photo {
  id        String   @id @default(cuid())
  schoolId  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student?
  teacher     Teacher?
  staffMember StaffMember?
}

// A document (Aadhaar, PAN, resume, certificates…) belonging to exactly one
// student, teacher or non-teaching staff member. File bytes live in DocumentFile so listing documents
// never loads file contents.
model Document {
  id             String       @id @default(cuid())
  schoolId       String
  studentId      String?
  teacherId      String?
  staffMemberId  String?
  type           DocumentType
  title          String
  documentNumber String? // e.g. Aadhaar or PAN number
  fileName       String
  mimeType       String
  size           Int
  fileId         String       @unique
  createdAt      DateTime     @default(now())

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher     Teacher?     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  file        DocumentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([teacherId])
  @@index([staffMemberId])
}

model DocumentFile {
  id       String    @id @default(cuid())
  data     Bytes
  document Document?
}

// Atomic sequence per school, used to generate human-readable IDs
// such as STU-2026-0001 and TCH-0001.
model Counter {
  schoolId String
  key      String
  value    Int    @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, key])
}

model Student {
  id                    String           @id @default(cuid())
  schoolId              String
  studentCode           String // unique, human-readable student ID, e.g. STU-2026-0001
  firstName             String
  middleName            String?
  lastName              String
  gender                Gender?
  bloodGroup            BloodGroup?
  dateOfBirth           DateTime?
  email                 String?
  phone                 String?
  whatsappNumber        String?
  aadhaarNumber         String? // stored as "1234 5678 9012"
  category              StudentCategory?
  caste                 String?
  religion              String?
  nationality           String?
  primaryAddress        String?
  correspondenceAddress String?
  lastSchoolName        String?
  fatherName            String?
  fatherOccupation      String?
  guardianName          String?
  guardianRelation      String? // e.g. "Father", "Grandmother"
  motherName            String?
  admissionDate         DateTime         @default(now())
  status                Status           @default(ACTIVE)
  sectionId             String?
  rollNumber            Int? // in the current session
  houseId               String?
  transportRouteId      String? // school bus / van route, if the student uses one
  transportStop         String? // one of the route's stops
  feesFrom              DateTime?        @db.Date // charge fees from this month instead of the admission month (set by fees staff)
  feesFromHeadIds       String[]         @default([]) // fees charged for months before admission; empty = all
  photoId               String?          @unique
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  school           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section          Section?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  house            House?             @relation(fields: [houseId], references: [id], onDelete: SetNull)
  transportRoute   TransportRoute?    @relation(fields: [transportRouteId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  photo            Photo?             @relation(fields: [photoId], references: [id], onDelete: SetNull)
  subjects         StudentSubject[]
  documents        Document[]
  attendance       AttendanceRecord[]
  leaveRequests    LeaveRequest[]
  feeHeads         StudentFeeHead[]
  feeReceipts      FeeReceipt[]
  noticeRecipients NoticeRecipient[]
  examMarks        ExamMark[]

  @@unique([schoolId, studentCode])
  @@index([sectionId])
  @@index([houseId])
}

model Teacher {
  id              String      @id @default(cuid())
  schoolId        String
  employeeCode    String // unique, human-readable staff ID, e.g. TCH-0001
  firstName       String
  middleName      String?
  lastName        String
  gender          Gender?
  bloodGroup      BloodGroup?
  dateOfBirth     DateTime?
  email           String?
  phone           String?
  whatsappNumber  String?
  address         String?
  qualification   String?
  specialization  String?
  experienceYears Int? // total teaching experience
  monthlySalary   Int? // in rupees
  joiningDate     DateTime    @default(now())
  status          Status      @default(ACTIVE)
  photoId         String?     @unique
  username        String?     @unique // teacher sign-in, e.g. dps.tch0001
  passwordHash    String?
  loginEnabled    Boolean     @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  photo              Photo?                     @relation(fields: [photoId], references: [id], onDelete: SetNull)
  classTeacherOf     Section[] // the sections they are class teacher of
  subjectAssignments SubjectTeacherAssignment[]
  documents          Document[]
  sessions           TeacherSession[]

  salaryPayments SalaryPayment[]
  notices        Notice[]
  exams          Exam[]
  timetableSlots TimetableSlot[]
  canTeach       TeacherSubject[]
  noticeMessages NoticeRecipient[]
  attendance     StaffAttendance[]
  leaveRequests  LeaveRequest[]

  @@unique([schoolId, employeeCode])
}

// Named SchoolClass because "class" is a reserved word in TypeScript.
model SchoolClass {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // e.g. "Class 1"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections Section[]
  subjects ClassSubject[]

  feeAmounts FeeAmount[]
  examPapers ExamPaper[]

  @@unique([schoolId, name])
}

model Section {
  id             String  @id @default(cuid())
  classId        String
  name           String // e.g. "A"
  classTeacherId String? // a teacher can be class teacher of several sections

  class              SchoolClass                @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher       Teacher?                   @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  students           Student[]
  enrollments        Enrollment[]
  subjectAssignments SubjectTeacherAssignment[]
  attendanceDays     AttendanceDay[]
  examSections       ExamSection[]
  examResults        ExamResult[]
  timetable          Timetable?
  timetableSlots     TimetableSlot[]
  examPapers         ExamPaper[]

  @@unique([classId, name])
  @@index([classTeacherId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  code      String // e.g. "MATH"
  createdAt DateTime @default(now())

  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes            ClassSubject[]
  students           StudentSubject[]
  teacherAssignments SubjectTeacherAssignment[]
  examPapers         ExamPaper[]
  timetableSlots     TimetableSlot[]
  qualifiedTeachers  TeacherSubject[]

  @@unique([schoolId, code])
}

// Curriculum: which subjects are taught in a class.
model ClassSubject {
  classId   String
  subjectId String

  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([classId, subjectId])
}

// Subjects allotted to an individual student. Filled from the class
// curriculum when the student is placed in a section; admin can adjust.
model StudentSubject {
  studentId String
  subjectId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([studentId, subjectId])
}

// Subjects a teacher can teach (set on the teacher's profile). Only these
// teachers are offered as that subject's teacher in a section.
model TeacherSubject {
  teacherId String
  subjectId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

// Subject teacher: who teaches a subject in a particular section.
model SubjectTeacherAssignment {
  id        String @id @default(cuid())
  sectionId String
  subjectId String
  teacherId String

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([sectionId, subjectId])
  @@index([teacherId])
}

// An academic year such as "2026-27". Exactly one per school is CURRENT.
model AcademicSession {
  id        String        @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    SessionStatus @default(UPCOMING)
  createdAt DateTime      @default(now())

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  feeHeads       FeeHead[]
  feeReceipts    FeeReceipt[]
  exams          Exam[]
  calendarEvents CalendarEvent[]

  @@unique([schoolId, name])
}

// A student's class, section and roll number for one session. The CURRENT
// session's enrollment mirrors Student.sectionId / Student.rollNumber.
model Enrollment {
  id         String            @id @default(cuid())
  sessionId  String
  studentId  String
  sectionId  String
  rollNumber Int?
  result     EnrollmentResult?
  createdAt  DateTime          @default(now())

  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Restrict: a section that holds class history cannot be deleted.
  section Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([sectionId])
}

// School logo, kept apart from School so loading a school never loads image bytes.
model SchoolLogo {
  schoolId  String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// Record of Power Admin actions (schools created, reset, deleted, cleanups…).
// Not linked to School so entries survive the school's deletion.
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  schoolId   String?
  schoolName String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// A school's admin account for the Admin Portal (signs in at /login).
// A cashier (role ACCOUNTANT) is always a non-teaching staff member made
// cashier from their profile; they see only Fees.
model SchoolAdmin {
  id            String    @id @default(cuid())
  schoolId      String
  name          String
  email         String    @unique // stored lower-case; used to sign in
  passwordHash  String
  role          StaffRole @default(ADMIN)
  active        Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  staffMemberId String?   @unique // cashiers: the staff member this account belongs to

  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessions    AdminSession[]
  staffMember StaffMember?   @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

// A signed-in admin session. `id` is the SHA-256 of the random token kept in
// the cookie, so a database leak doesn't reveal usable tokens.
model AdminSession {
  id        String   @id
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin SchoolAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// A signed-in teacher session (same scheme as AdminSession: id = SHA-256 of the cookie token).
model TeacherSession {
  id        String   @id
  teacherId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

// One section's attendance for one day. When `holiday` is set the class was
// off that day (declared by its class teacher or the school admin) and it has
// no records.
model AttendanceDay {
  id        String   @id @default(cuid())
  schoolId  String
  sectionId String
  date      DateTime @db.Date
  holiday   String? // reason, e.g. "Class picnic"
  markedBy  String? // who last saved it, e.g. "Kavya Menon (class teacher)"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@unique([sectionId, date])
  @@index([schoolId, date])
}

model AttendanceRecord {
  dayId     String
  studentId String
  status    AttendanceStatus
  remark    String?

  day     AttendanceDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([dayId, studentId])
  @@index([studentId])
}

// A teacher's or staff member's attendance for one day (exactly one of teacherId / staffId).
model StaffAttendance {
  id        String                @id @default(cuid())
  schoolId  String
  date      DateTime              @db.Date
  teacherId String?
  staffId   String?
  status    StaffAttendanceStatus
  remark    String?
  markedBy  String?
  updatedAt DateTime              @updatedAt

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher Teacher?     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staff   StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@unique([staffId, date])
  @@index([schoolId, date])
}

// A leave application by (or for) a student, teacher or staff member. Exactly
// one of studentId / teacherId / staffId is set, matching `applicant`.
model LeaveRequest {
  id           String         @id @default(cuid())
  schoolId     String
  applicant    LeaveApplicant
  studentId    String?
  teacherId    String?
  staffId      String?
  fromDate     DateTime       @db.Date
  toDate       DateTime       @db.Date
  category     LeaveCategory
  description  String?
  status       LeaveStatus    @default(PENDING)
  requestedBy  String // who entered it, e.g. "Kavya Menon (class teacher)"
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher?     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staff   StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([studentId])
  @@index([teacherId])
  @@index([staffId])
}

// A school bus or van route: the vehicle, its driver and its stops in order.
model TransportRoute {
  id             String   @id @default(cuid())
  schoolId       String
  routeNumber    String // e.g. "R-3"
  name           String? // e.g. "Civil Lines – Station Road"
  vehicleNumber  String // registration, e.g. "UP32 AB 1234"
  vehicleType    String? // e.g. "Bus (40 seats)", "Van"
  driverName     String?
  driverPhone    String?
  attendantName  String?
  attendantPhone String?
  stops          String[] // in order, e.g. "Hazratganj (7:10 am)"
  stopFares      Int[]    @default([]) // monthly fare in whole rupees, same order as stops; 0 = not set
  stopTimes      String[] @default([]) // pick-up time "HH:MM", same order as stops; "" = not set
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students Student[]

  @@unique([schoolId, routeNumber])
}

// A school-wide holiday: no class takes attendance that day.
model Holiday {
  id        String   @id @default(cuid())
  schoolId  String
  date      DateTime @db.Date
  name      String
  eventId   String? // added by a published calendar holiday; removed with it
  createdAt DateTime @default(now())

  school School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  event  CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
}

// A fee charged in one session, e.g. "Tuition fee" (monthly) or "Admission fee"
// (one time). Each class has its own amount; a class without an amount isn't
// charged. Optional heads (transport, hostel) apply only to students added to them.
model FeeHead {
  id        String       @id @default(cuid())
  schoolId  String
  sessionId String
  name      String
  frequency FeeFrequency
  optional  Boolean      @default(false)
  transport Boolean      @default(false) // amount is each student's stop fare (Transport), not per class; monthly, opt-in
  dueDay    Int          @default(10) // day of the month the fee is due
  dueMonth  Int? // YEARLY only: 1–12
  lateFee   Int          @default(0) // extra charge when an instalment is paid after its due day
  lateFeeMonthly Boolean @default(true) // charge the late fee again for every month it stays unpaid (false = once)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session      AcademicSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  amounts      FeeAmount[]
  students     StudentFeeHead[]
  receiptItems FeeReceiptItem[]

  @@unique([sessionId, name])
  @@index([schoolId])
}

model FeeAmount {
  headId  String
  classId String
  amount  Int // whole rupees

  head  FeeHead     @relation(fields: [headId], references: [id], onDelete: Cascade)
  class SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([headId, classId])
}

// A student added to an optional fee head (e.g. uses the school bus).
model StudentFeeHead {
  studentId String
  headId    String
  fromDate  DateTime? @db.Date // charged from this month (the month the student was added); null = whole session
  toDate    DateTime? @db.Date // charged up to this month (its first day); null = to the end of the session
  createdAt DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  head    FeeHead @relation(fields: [headId], references: [id], onDelete: Cascade)

  @@id([studentId, headId])
  @@index([headId])
}

// A payment. Receipts are never deleted, only cancelled; the student's name,
// ID and class are copied so the receipt stays readable later.
model FeeReceipt {
  id           String      @id @default(cuid())
  schoolId     String
  sessionId    String
  studentId    String?
  number       String // e.g. "2026-27/0001"
  date         DateTime    @db.Date
  mode         PaymentMode
  reference    String? // UPI / cheque / transaction number
  remarks      String?
  total        Int
  studentName  String
  studentCode  String
  className    String?
  collectedBy  String
  createdAt    DateTime    @default(now())
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?
  discountNote String? // why a discount was given (required when any line has one)
  lateWaived   Int         @default(0) // late fee the collector chose not to charge (whole or some months)
  feeNote      String? // how fees before a mid-session admission were handled, as at this payment

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session AcademicSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  items   FeeReceiptItem[]

  @@unique([schoolId, number])
  @@index([studentId])
  @@index([schoolId, date])
}

model FeeReceiptItem {
  id          String  @id @default(cuid())
  receiptId   String
  headId      String?
  headName    String
  period      String // e.g. "2026-04", "Q1", "H2", "Y", "ONCE"
  periodLabel String
  amount      Int // paid
  discount    Int     @default(0) // waived off this instalment; it counts as settled
  lateFee     Int     @default(0) // late fee collected with this instalment (on top of `amount`)
  charged     Int     @default(0) // the instalment's full amount when this was paid; it keeps that price later (0 = not recorded)

  receipt FeeReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  head    FeeHead?   @relation(fields: [headId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([headId, period])
}

// Non-teaching staff on the payroll: office staff, guards, helpers, drivers…
// Only a staff member made cashier can sign in (a SchoolAdmin with role
// ACCOUNTANT, which sees only Fees); everyone else has no login.
model StaffMember {
  id              String      @id @default(cuid())
  schoolId        String
  employeeCode    String // unique, human-readable staff ID, e.g. STF-0001
  name            String
  designation     String // e.g. "Security guard"
  department      String? // e.g. "Administration", "Transport"
  gender          Gender?
  bloodGroup      BloodGroup?
  dateOfBirth     DateTime?
  email           String?
  phone           String?
  whatsappNumber  String?
  address         String?
  qualification   String? // e.g. "B.Com", "12th pass"
  experienceYears Int? // total work experience
  monthlySalary   Int?
  joiningDate     DateTime?
  status          Status      @default(ACTIVE)
  photoId         String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  photo          Photo?            @relation(fields: [photoId], references: [id], onDelete: SetNull)
  documents      Document[]
  salaryPayments SalaryPayment[]
  cashierAccount SchoolAdmin?
  noticeMessages NoticeRecipient[]
  attendance     StaffAttendance[]
  leaveRequests  LeaveRequest[]

  @@unique([schoolId, employeeCode])
  @@index([schoolId])
}

// One person's salary paid for one month. Name and role are copied so the
// record stays readable after someone leaves.
model SalaryPayment {
  id        String      @id @default(cuid())
  schoolId  String
  month     String // "2026-09"
  payeeType PayeeType
  teacherId String?
  staffId   String?
  name      String
  role      String
  amount    Int
  paidOn    DateTime    @db.Date
  mode      PaymentMode
  note      String?
  createdBy String
  createdAt DateTime    @default(now())

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  staff   StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@unique([teacherId, month])
  @@unique([staffId, month])
  @@index([schoolId, month])
}

// What money is spent on. The "Salaries" category is built in: its spending
// comes from salary payments. A monthly budget applies to every month.
model ExpenseCategory {
  id            String   @id @default(cuid())
  schoolId      String
  name          String
  monthlyBudget Int?
  isSalaries    Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([schoolId, name])
}

model Expense {
  id          String      @id @default(cuid())
  schoolId    String
  categoryId  String
  date        DateTime    @db.Date
  amount      Int
  paidTo      String?
  description String?
  mode        PaymentMode
  reference   String?
  createdBy   String
  createdAt   DateTime    @default(now())

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([schoolId, date])
  @@index([categoryId])
}

// WhatsApp and SMS providers for sending notices. Provider settings (API keys)
// are stored encrypted with the SECRETS_KEY environment variable.
model MessagingSettings {
  schoolId         String   @id
  whatsappProvider String? // "meta", "twilio", "http", "test"
  whatsappConfig   String? // encrypted JSON
  smsProvider      String? // "fast2sms", "twilio", "http", "test"
  smsConfig        String? // encrypted JSON
  teachersCanSend  Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// A notice sent by an admin or a class teacher: by WhatsApp/SMS to students'
// parents, and (admins) to teachers and non-teaching staff. Messages go out at
// `publishAt` (now, or 7 AM on a later publish date); the notice is active until
// the end of `expiresOn`, and shows on teachers' and staff notice boards.
model Notice {
  id          String           @id @default(cuid())
  schoolId    String
  title       String
  body        String
  channels    MessageChannel[]
  audience    String // e.g. "Class 1 – A, Teachers" or "Absent on 26 Sept"
  forTeachers Boolean          @default(false)
  forStaff    Boolean          @default(false)
  sentBy      String
  teacherId   String?
  publishAt   DateTime         @default(now())
  expiresOn   DateTime?        @db.Date // last active day; older notices have none
  createdAt   DateTime         @default(now())

  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher    Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  recipients NoticeRecipient[]
  attachment NoticeAttachment?

  @@index([schoolId, createdAt])
  @@index([publishAt])
}

// A notice's file (PDF, PNG or JPG). Messages carry a link with `token`
// (unguessable), which opens the file without signing in until the notice expires.
model NoticeAttachment {
  noticeId String @id
  token    String @unique
  fileName String
  mimeType String
  size     Int
  data     Bytes

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
}

// One message to one phone on one channel, with its delivery result. The
// recipient is a student's parent, a teacher or a staff member.
model NoticeRecipient {
  id          String         @id @default(cuid())
  noticeId    String
  studentId   String?
  teacherId   String?
  staffId     String?
  name        String
  className   String?
  phone       String?
  channel     MessageChannel
  message     String // with the student's details filled in
  status      DeliveryStatus @default(PENDING)
  error       String?
  providerRef String?
  sentAt      DateTime?

  notice  Notice       @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  student Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  teacher Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  staff   StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([noticeId, status])
  @@index([studentId])
}

/**
 * ───────────────────────── Exams & tests ─────────────────────────
 */

enum ExamKind {
  EXAM // scheduled by the school admin
  TEST // created by a teacher for their sections
}

/// An exam (admin) or class test (teacher) with its date sheet.
model Exam {
  id            String   @id @default(cuid())
  schoolId      String
  sessionId     String
  kind          ExamKind @default(EXAM)
  name          String // e.g. "Half-yearly examination"
  instructions  String? // printed under the timetable, one per line
  published     Boolean  @default(false) // admin exams: shown to teachers once published
  teacherId     String? // the teacher who created a test
  createdBy     String
  printSettings Json? // saved print layout and options
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session  AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teacher  Teacher?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  sections ExamSection[]
  papers   ExamPaper[]
  results  ExamResult[]

  @@index([schoolId, sessionId, kind])
  @@index([teacherId])
}

/// The class sections an exam is for.
model ExamSection {
  examId    String
  sectionId String

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([examId, sectionId])
  @@index([sectionId])
}

/// One paper in the date sheet. classId null = every class in the exam.
model ExamPaper {
  id        String   @id @default(cuid())
  examId    String
  date      DateTime @db.Date
  startTime String // "09:00" (24-hour)
  endTime   String
  classId   String?
  sectionId String? // only this section of the class (null = every section of it)
  subjectId String?
  title     String? // custom paper name, e.g. "Practical" or "Drawing"
  maxMarks  Int?
  optional  Boolean  @default(false) // an optional paper: graded on its own pass marks, left out of the total
  passMarks Int? // optional papers only
  room      String?
  notes     String?

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  class   SchoolClass? @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject?     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  marks   ExamMark[]

  @@index([examId, date])
  @@index([subjectId])
}

/// A student's marks in one paper. `marks` is null when absent.
model ExamMark {
  id        String   @id @default(cuid())
  paperId   String
  studentId String
  marks     Float?
  absent    Boolean  @default(false)
  enteredBy String
  updatedAt DateTime @updatedAt

  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([paperId, studentId])
  @@index([studentId])
}

/// Results of an exam published for one section. While published, marks are locked.
model ExamResult {
  examId      String
  sectionId   String
  publishedAt DateTime @default(now())
  publishedBy String

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([examId, sectionId])
  @@index([sectionId])
}

/**
 * ───────────────────────── Timetable ─────────────────────────
 */

// The school's bell schedule: the periods of a day, shared by every class timetable.
model Period {
  id        String  @id @default(cuid())
  schoolId  String
  name      String // e.g. "Period 1", "Lunch break"
  startTime String // "08:00" (24-hour)
  endTime   String
  isBreak   Boolean @default(false) // breaks are shown but not filled in
  sortOrder Int     @default(0)

  school School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slots  TimetableSlot[]

  @@index([schoolId])
}

// A section's weekly timetable. Admins can lock it so the class teacher can't edit.
model Timetable {
  sectionId String   @id
  locked    Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

// What a section has in one period on one day.
model TimetableSlot {
  id        String  @id @default(cuid())
  sectionId String
  day       Int // 1 = Monday … 7 = Sunday
  periodId  String
  subjectId String?
  teacherId String?
  label     String? // instead of a subject, e.g. "Library" or "Games"

  section Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  period  Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([sectionId, day, periodId])
  @@index([teacherId])
}

/**
 * ───────────────────────── School calendar ─────────────────────────
 */

enum CalendarEventType {
  HOLIDAY
  EXAM
  TEST
  EVENT
  SPORTS
  MEETING // e.g. parent-teacher meeting
  ACTIVITY
}

// The session plan made by the admin. Teachers see it once published;
// a published holiday also becomes a school holiday for attendance.
model CalendarEvent {
  id          String            @id @default(cuid())
  schoolId    String
  sessionId   String
  type        CalendarEventType
  title       String
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  description String?
  classIds    String[] // empty = the whole school
  published   Boolean           @default(false)
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  school     School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session    AcademicSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  holidays   Holiday[]
  attachment CalendarAttachment?

  @@index([schoolId, startDate])
}

// A calendar entry's file (circular, schedule, poster): a PDF, PNG or JPG up to 4 MB.
model CalendarAttachment {
  eventId   String   @id
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}
