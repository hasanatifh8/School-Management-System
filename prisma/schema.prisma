// School Management System — data model.
// Every record belongs to a School so the app can later serve several schools
// from one database (created by a Super Admin).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE // "removed" — kept for history instead of being deleted
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SessionStatus {
  UPCOMING
  CURRENT
  CLOSED
}

// Outcome of a student's year, set when the class is promoted.
enum EnrollmentResult {
  PROMOTED
  DETAINED
  LEFT
  PASSED_OUT
}

enum StudentCategory {
  GENERAL
  OBC
  SC_ST
  MINORITY
}

// Who a school admin account is: a full admin, or non-teaching staff who
// only see the Fees section.
enum StaffRole {
  ADMIN
  ACCOUNTANT
}

enum FeeFrequency {
  ONE_TIME // once per student, e.g. admission fee (students admitted this session)
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY // once a session, in a chosen month (annual charges, extra dues)
}

enum PaymentMode {
  CASH
  UPI
  CARD
  CHEQUE
  BANK_TRANSFER
  OTHER
}

enum MessageChannel {
  WHATSAPP
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // no phone number
}

enum PayeeType {
  TEACHER
  STAFF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum DocumentType {
  AADHAAR
  PAN
  BIRTH_CERTIFICATE
  TRANSFER_CERTIFICATE
  MARKSHEET
  CASTE_CERTIFICATE
  MEDICAL_CERTIFICATE
  RESUME
  EDUCATION_CERTIFICATE
  EXPERIENCE_LETTER
  ADDRESS_PROOF
  OTHER
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

model School {
  id              String       @id @default(cuid())
  name            String
  code            String       @unique
  status          SchoolStatus @default(ACTIVE)
  board           String?
  principalName   String?
  establishedYear Int?
  motto           String?
  address         String?
  phone           String?
  email           String?
  website         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  logo   SchoolLogo?
  admins SchoolAdmin[]

  students  Student[]
  teachers  Teacher[]
  classes   SchoolClass[]
  subjects  Subject[]
  counters  Counter[]
  photos    Photo[]
  documents Document[]
  houses    House[]
  sessions  AcademicSession[]

  attendanceDays AttendanceDay[]
  holidays       Holiday[]
  feeHeads       FeeHead[]
  feeReceipts    FeeReceipt[]
  staffMembers   StaffMember[]
  salaryPayments SalaryPayment[]
  expenseCats    ExpenseCategory[]
  expenses       Expense[]
  messaging      MessagingSettings?
  notices        Notice[]
  exams          Exam[]
}

// A school house (e.g. "Green House"). Names and colours are set by the admin.
model House {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  color       String // palette key, see src/lib/houses.ts
  description String?
  createdAt   DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students Student[]

  @@unique([schoolId, name])
}

// Passport photo of a student or teacher. Kept in its own table so that
// loading people never loads image bytes unless they are requested.
model Photo {
  id        String   @id @default(cuid())
  schoolId  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student?
  teacher Teacher?
}

// A document (Aadhaar, PAN, resume, certificates…) belonging to exactly one
// student or teacher. File bytes live in DocumentFile so listing documents
// never loads file contents.
model Document {
  id             String       @id @default(cuid())
  schoolId       String
  studentId      String?
  teacherId      String?
  type           DocumentType
  title          String
  documentNumber String? // e.g. Aadhaar or PAN number
  fileName       String
  mimeType       String
  size           Int
  fileId         String       @unique
  createdAt      DateTime     @default(now())

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher?     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  file    DocumentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([teacherId])
}

model DocumentFile {
  id       String    @id @default(cuid())
  data     Bytes
  document Document?
}

// Atomic sequence per school, used to generate human-readable IDs
// such as STU-2026-0001 and TCH-0001.
model Counter {
  schoolId String
  key      String
  value    Int    @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, key])
}

model Student {
  id                    String           @id @default(cuid())
  schoolId              String
  studentCode           String // unique, human-readable student ID, e.g. STU-2026-0001
  firstName             String
  middleName            String?
  lastName              String
  gender                Gender?
  bloodGroup            BloodGroup?
  dateOfBirth           DateTime?
  email                 String?
  phone                 String?
  whatsappNumber        String?
  aadhaarNumber         String? // stored as "1234 5678 9012"
  category              StudentCategory?
  caste                 String?
  religion              String?
  nationality           String?
  primaryAddress        String?
  correspondenceAddress String?
  lastSchoolName        String?
  fatherName            String?
  fatherOccupation      String?
  guardianName          String?
  motherName            String?
  admissionDate         DateTime         @default(now())
  status                Status           @default(ACTIVE)
  sectionId             String?
  rollNumber            Int? // in the current session
  houseId               String?
  photoId               String?          @unique
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  school           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section          Section?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  house            House?             @relation(fields: [houseId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  photo            Photo?             @relation(fields: [photoId], references: [id], onDelete: SetNull)
  subjects         StudentSubject[]
  documents        Document[]
  attendance       AttendanceRecord[]
  feeHeads         StudentFeeHead[]
  feeReceipts      FeeReceipt[]
  noticeRecipients NoticeRecipient[]
  examMarks        ExamMark[]

  @@unique([schoolId, studentCode])
  @@index([sectionId])
  @@index([houseId])
}

model Teacher {
  id              String      @id @default(cuid())
  schoolId        String
  employeeCode    String // unique, human-readable staff ID, e.g. TCH-0001
  firstName       String
  middleName      String?
  lastName        String
  gender          Gender?
  bloodGroup      BloodGroup?
  dateOfBirth     DateTime?
  email           String?
  phone           String?
  whatsappNumber  String?
  address         String?
  qualification   String?
  specialization  String?
  experienceYears Int? // total teaching experience
  monthlySalary   Int? // in rupees
  joiningDate     DateTime    @default(now())
  status          Status      @default(ACTIVE)
  photoId         String?     @unique
  username        String?     @unique // teacher sign-in, e.g. dps.tch0001
  passwordHash    String?
  loginEnabled    Boolean     @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  photo              Photo?                     @relation(fields: [photoId], references: [id], onDelete: SetNull)
  classTeacherOf     Section?
  subjectAssignments SubjectTeacherAssignment[]
  documents          Document[]
  sessions           TeacherSession[]

  salaryPayments SalaryPayment[]
  notices        Notice[]
  exams          Exam[]

  @@unique([schoolId, employeeCode])
}

// Named SchoolClass because "class" is a reserved word in TypeScript.
model SchoolClass {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // e.g. "Class 1"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections Section[]
  subjects ClassSubject[]

  feeAmounts FeeAmount[]
  examPapers ExamPaper[]

  @@unique([schoolId, name])
}

model Section {
  id             String  @id @default(cuid())
  classId        String
  name           String // e.g. "A"
  classTeacherId String? @unique // a teacher can be class teacher of only one section

  class              SchoolClass                @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher       Teacher?                   @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  students           Student[]
  enrollments        Enrollment[]
  subjectAssignments SubjectTeacherAssignment[]
  attendanceDays     AttendanceDay[]
  examSections       ExamSection[]
  examResults        ExamResult[]

  @@unique([classId, name])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  code      String // e.g. "MATH"
  createdAt DateTime @default(now())

  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes            ClassSubject[]
  students           StudentSubject[]
  teacherAssignments SubjectTeacherAssignment[]
  examPapers         ExamPaper[]

  @@unique([schoolId, code])
}

// Curriculum: which subjects are taught in a class.
model ClassSubject {
  classId   String
  subjectId String

  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([classId, subjectId])
}

// Subjects allotted to an individual student. Filled from the class
// curriculum when the student is placed in a section; admin can adjust.
model StudentSubject {
  studentId String
  subjectId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([studentId, subjectId])
}

// Subject teacher: who teaches a subject in a particular section.
model SubjectTeacherAssignment {
  id        String @id @default(cuid())
  sectionId String
  subjectId String
  teacherId String

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([sectionId, subjectId])
  @@index([teacherId])
}

// An academic year such as "2026-27". Exactly one per school is CURRENT.
model AcademicSession {
  id        String        @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    SessionStatus @default(UPCOMING)
  createdAt DateTime      @default(now())

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  feeHeads    FeeHead[]
  feeReceipts FeeReceipt[]
  exams       Exam[]

  @@unique([schoolId, name])
}

// A student's class, section and roll number for one session. The CURRENT
// session's enrollment mirrors Student.sectionId / Student.rollNumber.
model Enrollment {
  id         String            @id @default(cuid())
  sessionId  String
  studentId  String
  sectionId  String
  rollNumber Int?
  result     EnrollmentResult?
  createdAt  DateTime          @default(now())

  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Restrict: a section that holds class history cannot be deleted.
  section Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([sectionId])
}

// School logo, kept apart from School so loading a school never loads image bytes.
model SchoolLogo {
  schoolId  String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// Record of Power Admin actions (schools created, reset, deleted, cleanups…).
// Not linked to School so entries survive the school's deletion.
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  schoolId   String?
  schoolName String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// A school's admin account for the Admin Portal (signs in at /login).
model SchoolAdmin {
  id           String    @id @default(cuid())
  schoolId     String
  name         String
  email        String    @unique // stored lower-case; used to sign in
  passwordHash String
  role         StaffRole @default(ADMIN)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessions AdminSession[]

  @@index([schoolId])
}

// A signed-in admin session. `id` is the SHA-256 of the random token kept in
// the cookie, so a database leak doesn't reveal usable tokens.
model AdminSession {
  id        String   @id
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin SchoolAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// A signed-in teacher session (same scheme as AdminSession: id = SHA-256 of the cookie token).
model TeacherSession {
  id        String   @id
  teacherId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

// One section's attendance for one day. When `holiday` is set the class was
// off that day (declared by its class teacher or the school admin) and it has
// no records.
model AttendanceDay {
  id        String   @id @default(cuid())
  schoolId  String
  sectionId String
  date      DateTime @db.Date
  holiday   String? // reason, e.g. "Class picnic"
  markedBy  String? // who last saved it, e.g. "Kavya Menon (class teacher)"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@unique([sectionId, date])
  @@index([schoolId, date])
}

model AttendanceRecord {
  dayId     String
  studentId String
  status    AttendanceStatus
  remark    String?

  day     AttendanceDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([dayId, studentId])
  @@index([studentId])
}

// A school-wide holiday: no class takes attendance that day.
model Holiday {
  id        String   @id @default(cuid())
  schoolId  String
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
}

// A fee charged in one session, e.g. "Tuition fee" (monthly) or "Admission fee"
// (one time). Each class has its own amount; a class without an amount isn't
// charged. Optional heads (transport, hostel) apply only to students added to them.
model FeeHead {
  id        String       @id @default(cuid())
  schoolId  String
  sessionId String
  name      String
  frequency FeeFrequency
  optional  Boolean      @default(false)
  dueDay    Int          @default(10) // day of the month the fee is due
  dueMonth  Int? // YEARLY only: 1–12
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session      AcademicSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  amounts      FeeAmount[]
  students     StudentFeeHead[]
  receiptItems FeeReceiptItem[]

  @@unique([sessionId, name])
  @@index([schoolId])
}

model FeeAmount {
  headId  String
  classId String
  amount  Int // whole rupees

  head  FeeHead     @relation(fields: [headId], references: [id], onDelete: Cascade)
  class SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([headId, classId])
}

// A student added to an optional fee head (e.g. uses the school bus).
model StudentFeeHead {
  studentId String
  headId    String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  head    FeeHead @relation(fields: [headId], references: [id], onDelete: Cascade)

  @@id([studentId, headId])
  @@index([headId])
}

// A payment. Receipts are never deleted, only cancelled; the student's name,
// ID and class are copied so the receipt stays readable later.
model FeeReceipt {
  id           String      @id @default(cuid())
  schoolId     String
  sessionId    String
  studentId    String?
  number       String // e.g. "2026-27/0001"
  date         DateTime    @db.Date
  mode         PaymentMode
  reference    String? // UPI / cheque / transaction number
  remarks      String?
  total        Int
  studentName  String
  studentCode  String
  className    String?
  collectedBy  String
  createdAt    DateTime    @default(now())
  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session AcademicSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  items   FeeReceiptItem[]

  @@unique([schoolId, number])
  @@index([studentId])
  @@index([schoolId, date])
}

model FeeReceiptItem {
  id          String  @id @default(cuid())
  receiptId   String
  headId      String?
  headName    String
  period      String // e.g. "2026-04", "Q1", "H2", "Y", "ONCE"
  periodLabel String
  amount      Int

  receipt FeeReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  head    FeeHead?   @relation(fields: [headId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([headId, period])
}

// Non-teaching staff on the payroll: office staff, guards, helpers, drivers…
// (Separate from sign-in accounts; a staff member may or may not have one.)
model StaffMember {
  id            String    @id @default(cuid())
  schoolId      String
  name          String
  designation   String // e.g. "Security guard"
  phone         String?
  monthlySalary Int?
  joiningDate   DateTime?
  status        Status    @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  salaryPayments SalaryPayment[]

  @@index([schoolId])
}

// One person's salary paid for one month. Name and role are copied so the
// record stays readable after someone leaves.
model SalaryPayment {
  id        String      @id @default(cuid())
  schoolId  String
  month     String // "2026-09"
  payeeType PayeeType
  teacherId String?
  staffId   String?
  name      String
  role      String
  amount    Int
  paidOn    DateTime    @db.Date
  mode      PaymentMode
  note      String?
  createdBy String
  createdAt DateTime    @default(now())

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  staff   StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@unique([teacherId, month])
  @@unique([staffId, month])
  @@index([schoolId, month])
}

// What money is spent on. The "Salaries" category is built in: its spending
// comes from salary payments. A monthly budget applies to every month.
model ExpenseCategory {
  id            String   @id @default(cuid())
  schoolId      String
  name          String
  monthlyBudget Int?
  isSalaries    Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([schoolId, name])
}

model Expense {
  id          String      @id @default(cuid())
  schoolId    String
  categoryId  String
  date        DateTime    @db.Date
  amount      Int
  paidTo      String?
  description String?
  mode        PaymentMode
  reference   String?
  createdBy   String
  createdAt   DateTime    @default(now())

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([schoolId, date])
  @@index([categoryId])
}

// WhatsApp and SMS providers for sending notices. Provider settings (API keys)
// are stored encrypted with the SECRETS_KEY environment variable.
model MessagingSettings {
  schoolId         String   @id
  whatsappProvider String? // "meta", "twilio", "http", "test"
  whatsappConfig   String? // encrypted JSON
  smsProvider      String? // "fast2sms", "twilio", "http", "test"
  smsConfig        String? // encrypted JSON
  teachersCanSend  Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// A message sent to parents, by an admin or a class teacher.
model Notice {
  id        String           @id @default(cuid())
  schoolId  String
  title     String
  body      String
  channels  MessageChannel[]
  audience  String // e.g. "Class 1 – A, Class 2 – B" or "Absent on 26 Sept"
  sentBy    String
  teacherId String?
  createdAt DateTime         @default(now())

  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher    Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  recipients NoticeRecipient[]

  @@index([schoolId, createdAt])
}

// One message to one phone on one channel, with its delivery result.
model NoticeRecipient {
  id          String         @id @default(cuid())
  noticeId    String
  studentId   String?
  name        String
  className   String?
  phone       String?
  channel     MessageChannel
  message     String // with the student's details filled in
  status      DeliveryStatus @default(PENDING)
  error       String?
  providerRef String?
  sentAt      DateTime?

  notice  Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([noticeId, status])
  @@index([studentId])
}

/**
 * ───────────────────────── Exams & tests ─────────────────────────
 */

enum ExamKind {
  EXAM // scheduled by the school admin
  TEST // created by a teacher for their sections
}

/// An exam (admin) or class test (teacher) with its date sheet.
model Exam {
  id            String   @id @default(cuid())
  schoolId      String
  sessionId     String
  kind          ExamKind @default(EXAM)
  name          String // e.g. "Half-yearly examination"
  instructions  String? // printed under the timetable, one per line
  published     Boolean  @default(false) // admin exams: shown to teachers once published
  teacherId     String? // the teacher who created a test
  createdBy     String
  printSettings Json? // saved print layout and options
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session  AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teacher  Teacher?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  sections ExamSection[]
  papers   ExamPaper[]
  results  ExamResult[]

  @@index([schoolId, sessionId, kind])
  @@index([teacherId])
}

/// The class sections an exam is for.
model ExamSection {
  examId    String
  sectionId String

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([examId, sectionId])
  @@index([sectionId])
}

/// One paper in the date sheet. classId null = every class in the exam.
model ExamPaper {
  id        String   @id @default(cuid())
  examId    String
  date      DateTime @db.Date
  startTime String // "09:00" (24-hour)
  endTime   String
  classId   String?
  subjectId String?
  title     String? // custom paper name, e.g. "Practical" or "Drawing"
  maxMarks  Int?
  room      String?
  notes     String?

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  class   SchoolClass? @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject?     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  marks   ExamMark[]

  @@index([examId, date])
  @@index([subjectId])
}

/// A student's marks in one paper. `marks` is null when absent.
model ExamMark {
  id        String   @id @default(cuid())
  paperId   String
  studentId String
  marks     Float?
  absent    Boolean  @default(false)
  enteredBy String
  updatedAt DateTime @updatedAt

  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([paperId, studentId])
  @@index([studentId])
}

/// Results of an exam published for one section. While published, marks are locked.
model ExamResult {
  examId      String
  sectionId   String
  publishedAt DateTime @default(now())
  publishedBy String

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([examId, sectionId])
  @@index([sectionId])
}
